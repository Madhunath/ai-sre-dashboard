# =============================================================================
# AI SRE Reliability Console - Environment Configuration Example
# =============================================================================
# Copy this file to '.env' in the root directory and update the settings.
# All settings below will be loaded automatically by config.py on startup.

# -----------------------------------------------------------------------------
# 1. AI API Configuration
# -----------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API Key (Required for AI features).
# Retrieve one from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiAPIKeyHere

# -----------------------------------------------------------------------------
# 2. Database Connection (MySQL / MariaDB)
# -----------------------------------------------------------------------------
# The schema tables are initialized automatically using 'python create_admin.py'.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sre_admin
MYSQL_PASSWORD=your_mysql_secure_password
MYSQL_DATABASE=sre_agent

# -----------------------------------------------------------------------------
# 3. Initial Administrative Credentials
# -----------------------------------------------------------------------------
# ADMIN_SECRET_KEY: Secret key used by Flask for signing session cookies.
ADMIN_SECRET_KEY=change-this-to-a-secure-random-secret-key-string

# ADMIN_USERNAME / ADMIN_PASSWORD: Credentials used by 'create_admin.py'
# to register the primary system administrator account in the MySQL database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_console_password_here

# -----------------------------------------------------------------------------
# 4. SITE RELIABILITY ENGINE (SRE) - Monitoring Settings
# -----------------------------------------------------------------------------
# MONITOR_INTERVAL_SECONDS: The frequency in seconds of SRE health checks. (default: 15)
# Set this to a higher value (e.g. 60) in production environments.
MONITOR_INTERVAL_SECONDS=60

# DEFAULT_LOG_LINES: Number of tailing log lines to read from container outputs
# or journalctl when assembling diagnostic files (default: 80, Max: 1000).
DEFAULT_LOG_LINES=80

# MONITORING_MODE: Run mode of the monitoring daemon loop.
# Supported options: 'continuous' (infinite loop) or 'one-shot' (exits after 1 cycle).
MONITORING_MODE=continuous

# HEALTHCHECK_URLS: Comma-separated list of URLs to query via HTTP GET requests.
# SRE logs an alert if any target responds with status >= 400 or fails to connect.
# Example: http://localhost:80/health,http://localhost:8080/ready
HEALTHCHECK_URLS=http://localhost:5000/admin/monitor-status

# -----------------------------------------------------------------------------
# 5. SRE AUTO-REMEDIATION & RECOVERY POLICIES
# -----------------------------------------------------------------------------
# AUTO_RESTART_FAILED_SERVICE_ONCE: If true, SRE daemon automatically runs
# 'sudo systemctl restart <service>' once if a systemd unit is failed.
AUTO_RESTART_FAILED_SERVICE_ONCE=True

# AUTO_KILL_PROCESS: If true, SRE daemon is allowed to force terminate (kill -9)
# system processes exceeding resource utilization safety thresholds.
AUTO_KILL_PROCESS=False

# SRE_COOLDOWN_PERIOD_SECONDS: The minimum cooling time in seconds between
# SRE diagnostics reports (default: 30). Prevents alerts spam.
# Note: Must be greater than or equal to MONITOR_INTERVAL_SECONDS.
SRE_COOLDOWN_PERIOD_SECONDS=60

# -----------------------------------------------------------------------------
# 6. AWS SNS Integration (Alert Notifications)
# -----------------------------------------------------------------------------
# AWS_REGION: The AWS Region where your Simple Notification Service (SNS) is deployed.
AWS_REGION=us-west-1

# SNS_TOPIC_ARN: The ARN of the Amazon SNS topic. Triggered on system faults
# to send email notifications to subscribed DevOps engineers.
SNS_TOPIC_ARN=arn:aws:sns:us-west-1:123456789012:sre-alerts-topic

# AWS Credentials (Optional)
# If omitted, the system will fall back to using your local ~/.aws/ credentials 
# or generate mock AWS billing and infrastructure telemetry data for demonstration.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN=your-aws-session-token

# -----------------------------------------------------------------------------
# 7. SRE State Lock Files (Temporary paths)
# -----------------------------------------------------------------------------
# SRE_COOLDOWN_LOCK_FILE: Lock file path ensuring only one daemon cycle runs at a time.
# If left blank, the daemon defaults to using the host system temporary directory.
SRE_COOLDOWN_LOCK_FILE=/tmp/sre_agent_cooldown.lock

# SRE_STATE_FILE: File path storing the persistent classification state of the SRE.
# If left blank, the daemon defaults to using the host system temporary directory.
SRE_STATE_FILE=/tmp/sre_agent_state.json
